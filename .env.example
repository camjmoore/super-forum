# Node environment
NODE_ENV=development

# Server port
PORT=4000

# PostgreSQL configuration
PG_HOST=postgres
PG_PORT=5432
PG_ACCOUNT=forum_user
PG_PASSWORD=forum_password
PG_DATABASE=super_duper_forum
PG_SYNCHRONIZE=true
PG_LOGGING=true

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Client
CLIENT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql

# Session configuration
COOKIE_NAME=SESSIONID
SESSION_SECRET=dev_secret_key_change_in_production
CORS_ORIGIN=http://localhost:3000

# JWT secret for email verification tokens
JWT_SECRET=dev_jwt_secret_change_in_production

# Email configuration (Resend HTTP API - falls back to an Ethereal test inbox in dev if unset)
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM="Your App" <noreply@yourdomain.com>
